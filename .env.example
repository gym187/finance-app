# Database
DATABASE_URL="postgresql://finance:finance123@localhost:5432/financedb"
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance123
POSTGRES_DB=financedb
POSTGRES_PORT=5432

# JWT - Use long random strings (min 32 chars)
JWT_SECRET=change-me-to-a-very-long-random-secret-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-different-from-above
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Backend
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3002

# Telegram Bot - Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# For production webhook (leave empty for polling in dev)
WEBHOOK_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
